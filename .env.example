# Comma-separated email allowlist for the restricted ICS issuer review console.
ICS_ADMIN_EMAILS=
# TECRID's own email sender (sign-in links and notices). Resend key from TECRID's own account.
RESEND_API_KEY=
# Must be a tecrid.com address on a domain verified in that Resend account.
TECRID_EMAIL_FROM=TECRID <no-reply@tecrid.com>
# Optional comma-separated controller emails for the Kasandrinos TEST workspace
# (owners/admins of org_test_kasandrinos also qualify).
TECRID_KAS_TEST_CONTROLLER_EMAILS=
