# Comma-separated email allowlist for the restricted ICS issuer review console.
ICS_ADMIN_EMAILS=

# Notification channels. Keep automatic credential delivery off until the
# required issuance, routing, and sandbox safety release has been reviewed.
TECRID_DELIVERY_ENABLED=false
# Exactly 32 random bytes encoded as base64url; encrypts channel destinations.
TECRID_CHANNEL_SECRET=
TECRID_VAPID_PUBLIC_KEY=
TECRID_VAPID_PRIVATE_KEY=
TECRID_VAPID_SUBJECT=
TECRID_NOTIFICATION_EMAIL_RELAY_URL=
TECRID_NOTIFICATION_EMAIL_RELAY_SECRET=
TECRID_DELIVERY_WORKER_SECRET=
# Exact approved webhook DNS names, comma separated. No wildcards.
TECRID_WEBHOOK_HOSTS=
